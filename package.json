{
  "name": "dsh-blue-whale-maid",
  "version": "1.10.3",
  "description": "小鲸：陪你使用 DSH 的原创蓝鲸女仆桌宠与任务提醒伙伴",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "node tools/embed.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run build && npm test && node --check lib/index.js && node --check lib/session-cost.js && node --check lib/pricing.js && node --check src/client.template.js",
    "prepack": "npm run build"
  },
  "files": [
    "lib/*.js",
    "lib/types/*.d.ts",
    "assets/logo.gif",
    "cordis.patch.yml",
    "docs/character-bible.md",
    "README.md",
    "CREDITS.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "desktop-pet",
    "task-notifier",
    "blue-whale-maid"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuxino/dsh-blue-whale-maid.git"
  }
}

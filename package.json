{
  "name": "dsh-blue-whale-maid",
  "version": "2.0.0",
  "description": "DeepSeek Harness Web 的蓝鲸女仆桌宠，任务有动静时会在网页边上提醒你",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dsh": "^0.1.1-rc.2",
      "profiles": [
        "web"
      ],
      "dshReleases": {
        "rc.7": "unknown",
        "rc.8": "unknown",
        "0.1.1-rc.1": "unknown",
        "0.1.1-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "build": "node docs/development/embed.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run build && npm test && node --check lib/index.js && node --check src/client.template.js",
    "prepack": "npm run build"
  },
  "files": [
    "lib/*.js",
    "lib/types/*.d.ts",
    "assets/blue-whale-maid-v2.png",
    "cordis.patch.yml",
    "docs/character-bible.md",
    "README.md",
    "CREDITS.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "desktop-pet",
    "task-notifier",
    "blue-whale-maid"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuxino/dsh-blue-whale-maid.git"
  }
}
